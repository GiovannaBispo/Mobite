# Copie para .env (que não vai para o Git) e preencha. Sem .env, o app roda em modo de desenvolvimento.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Login com Google (credencial gratuita no Google Cloud Console). Vazio = botão do Google não aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail pelo Gmail com senha de app. Vazio = os e-mails aparecem no terminal.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

MOBITE_CONTATO_EMAIL=contato@mobite.example

# Senha das contas de teste criadas pelo dados_demo. Vazio = mobite2026 (só para o PC).
MOBITE_SENHA_DEMO=

# 1 = precisa confirmar o e-mail para avaliar. 0 = a conta nova já entra e avalia (use enquanto o e-mail não estiver configurado).
MOBITE_CONFIRMAR_EMAIL=1
